Pathfinder patch for jaq 3.1.0: `input` and `halt_error` as jq 1.8.1 has them.

Past the last input, jq's `input` raises the error "break", and it reads
only when its output is asked for, so `reduce (try input) as $x (input; ...)`
reads the initialiser's first. `halt_error` checks its status is a number
before it writes its message (`halt_error/1: number required`), takes the
status as C's `int` conversion does, and the process exits as jq's `main`
does: a negative status is 0, or under `-e` its absolute value. The same
changes are in crates/pathfinder-std and crates/pathfinder-jaq.

Carried in-tree (Steelbore Standard 4.2, 6.4); not sent upstream.

diff --git a/jaq-std/src/defs.jq b/jaq-std/src/defs.jq
index c63a99d..933c586 100644
--- a/jaq-std/src/defs.jq
+++ b/jaq-std/src/defs.jq
@@ -4,8 +4,6 @@ def debug(msgs): ((msgs | debug_empty) as $x | .), .;
 
 def halt: halt(0);
 # Pathfinder: jq 1.8.1 writes a string raw, nothing for null, else JSON and a newline.
-def halt_error($exit_code): (if . == null then empty elif . >= "" and . < [] then . else tojson + "\n" end | stderr_empty), halt($exit_code);
-def halt_error: halt_error(5);
 
 # Not defined in jq!
 def isboolean: . == true or . == false;
@@ -125,3 +123,7 @@ def @uri    : tostring | encode_uri;
 def @urid   : tostring | decode_uri;
 def @base64 : tostring | encode_base64;
 def @base64d: tostring | decode_base64;
+
+# Pathfinder: after the definitions it uses (`type`, `first`, `range`).
+def halt_error($exit_code): if ($exit_code | type) != "number" then error(type + " (" + (tojson | if utf8bytelength <= 14 then . else first(range(11; -1; -1) as $n | .[:$n] | select(utf8bytelength <= 11)) + "..." end) + ") halt_error/1: number required") else . end | (if . == null then empty elif . >= "" and . < [] then . else tojson + "\n" end | stderr_empty), halt($exit_code);
+def halt_error: halt_error(5);
diff --git a/jaq-std/src/input.rs b/jaq-std/src/input.rs
index 737d9e7..fac8387 100644
--- a/jaq-std/src/input.rs
+++ b/jaq-std/src/input.rs
@@ -42,7 +42,17 @@ where
 {
     Box::new([
         ("inputs", v(0), |cv| Box::new(inputs(cv))),
-        ("input", v(0), |cv| Box::new(inputs(cv).next().into_iter())),
+        // Pathfinder: past the last input, jq's `input` raises the error
+        // `"break"` (`f_input`), and reads only when its output is asked
+        // for, so `reduce (try input) as $x (input; …)` reads the
+        // initialiser's first.
+        ("input", v(0), |cv| {
+            Box::new(core::iter::once_with(move || {
+                inputs(cv)
+                    .next()
+                    .unwrap_or_else(|| Err(Exn::from(Error::str("break"))))
+            }))
+        }),
     ])
 }
 
diff --git a/jaq-std/src/lib.rs b/jaq-std/src/lib.rs
index 3810c42..5010132 100644
--- a/jaq-std/src/lib.rs
+++ b/jaq-std/src/lib.rs
@@ -447,13 +447,25 @@ where
                     .map(|s| ValT::from_utf8_bytes(s.replace(b"'", b"'\\''"))),
             )
         }),
+        // Pathfinder: jq's `main` takes the status as C's `int ret =
+        // jv_number_value(…)`: truncated, and `INT_MIN` where the x86-64
+        // conversion has no value (NaN, out of range).
         ("halt", v(1), |mut cv| {
-            let exit_code = cv.0.pop_var().try_as_i32().map_err(Exn::from);
+            let exit_code = cv.0.pop_var().try_as_f64().map(c_int).map_err(Exn::from);
             box_once(exit_code.and_then(|exit_code| Err(Exn::halt(exit_code))))
         }),
     ])
 }
 
+/// Pathfinder: C's conversion of a double to an `int` on x86-64.
+fn c_int(f: f64) -> i32 {
+    if f.is_nan() || !(-2_147_483_649.0 < f && f < 2_147_483_648.0) {
+        i32::MIN
+    } else {
+        f as i32
+    }
+}
+
 #[cfg(feature = "std")]
 fn now<V: From<String>>() -> Result<f64, Error<V>> {
     use std::time::{SystemTime, UNIX_EPOCH};
diff --git a/jaq/src/main.rs b/jaq/src/main.rs
index 7136b00..573fd59 100644
--- a/jaq/src/main.rs
+++ b/jaq/src/main.rs
@@ -68,6 +68,17 @@ fn main() -> io::Result<ExitCode> {
         }
     } else {
         real_main(&cli).or_else(|e| {
+            // Pathfinder: `halt`'s status as jq's `main` returns it: a
+            // negative one is 0, or under `-e` its absolute value; the
+            // system keeps the low byte.
+            if let Error::Halt(code) = e {
+                let status = if cli.exit_status {
+                    code.wrapping_abs()
+                } else {
+                    code.max(0)
+                };
+                return Ok(ExitCode::from(status.to_le_bytes()[0]));
+            }
             write!(err, "{}", ErrorColor::new(&e, cli.color_errors()))?;
             Ok(e.report())
         })
