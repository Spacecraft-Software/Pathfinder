+/// Pathfinder: the C library's text for an I/O error, as jq prints it:
+/// Rust's adds ` (os error N)`.
+fn strerror(e: &io::Error) -> String {
+    let s = e.to_string();
+    match e.raw_os_error() {
+        Some(n) => s
+            .strip_suffix(&format!(" (os error {n})"))
+            .map_or_else(|| s.clone(), str::to_string),
+        None => s,
+    }
+}
