Pathfinder patch for jaq 3.1.1: Read no input before the first value is asked for, as jq 1.8.1.

Carried in-tree (Steelbore Standard 4.2, 6.4); not sent upstream.

diff --git a/jaq-fmts/src/read/formats.rs b/jaq-fmts/src/read/formats.rs
index 0a3764c..10ffa9c 100644
--- a/jaq-fmts/src/read/formats.rs
+++ b/jaq-fmts/src/read/formats.rs
@@ -34,11 +34,11 @@ pub fn read<'a>(fmt: Format, read: impl io::BufRead + 'a, s: &'a str, slurp: boo
     use bstr::io::BufReadExt;
     let mut read = read;
     match fmt {
-        Format::Raw if slurp => {
+        // Pathfinder: read only when asked for, as `collect_if` slurps.
+        Format::Raw if slurp => Box::new(core::iter::once_with(move || {
             let mut buf = Vec::new();
-            let result = read.read_to_end(&mut buf);
-            box_once(result.map(|_| Val::utf8_str(buf)))
-        }
+            read.read_to_end(&mut buf).map(|_| Val::utf8_str(buf))
+        })),
         Format::Raw => Box::new(read.byte_lines().map(|r| r.map(Val::utf8_str))),
         Format::Raw0 => collect_if(slurp, read.byte_records(0).map(|r| r.map(Val::utf8_str))),
         Format::Cbor => collect_if(slurp, cbor::read_many(read)),
diff --git a/jaq-fmts/src/read/mod.rs b/jaq-fmts/src/read/mod.rs
index c3a8aa8..587e1bd 100644
--- a/jaq-fmts/src/read/mod.rs
+++ b/jaq-fmts/src/read/mod.rs
@@ -47,7 +47,9 @@ pub fn collect_if<'a, T: FromIterator<T> + 'a, E: 'a>(
     iter: impl Iterator<Item = Result<T, E>> + 'a,
 ) -> Box<dyn Iterator<Item = Result<T, E>> + 'a> {
     if slurp {
-        Box::new(core::iter::once(iter.collect()))
+        // Pathfinder: slurped only when asked for, so the reader is where jq's
+        // is when an input file turns out to be unreadable.
+        Box::new(core::iter::once_with(move || iter.collect()))
     } else {
         Box::new(iter)
     }
