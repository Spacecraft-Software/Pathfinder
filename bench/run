#!/bin/sh
# SPDX-FileCopyrightText: 2026 Mohamed Hammad <Mohamed.Hammad@SpacecraftSoftware.org>
# SPDX-License-Identifier: GPL-3.0-or-later
#
# bench/run — the benchmark set behind PRD R-011: no slower than jq 1.8.1,
# and within 10% of jaq 3.1.1 at the fork point, in user-space cycles.
#
#   bench/run ENGINE...
#
# ENGINE is NAME=[VAR=VALUE]... PROGRAM, one shell word:
#
#   bench/run jq=/path/to/jq-1.8.1 jaq=/path/to/jaq \
#       'pf-jaq=PATHFINDER_ENGINE=jaq PATHFINDER_JAQ=/path/to/jaq /path/to/bin/jq' \
#       'native=PATHFINDER_ENGINE=native /path/to/bin/jq'
#
# The part after NAME= is split on blanks, so paths and values in it cannot
# contain spaces. Leading VAR=VALUE words become the engine's environment;
# the rest is the program. Run Pathfinder through a `jq` symlink: under its
# own name it is not jq.
#
# Every engine gets the same jq command line. The engines named jq and jaq
# (override with BENCH_JQ / BENCH_JAQ) are the denominators of the ratio
# columns; every other engine gets an "×jq" and an "×jaq" column.
#
# Environment:
#   BENCH_DATA          input directory; generated by bench/gen if incomplete
#                       (default ${TMPDIR:-/tmp}/pathfinder-bench)
#   BENCH_REPS          runs per case and engine, median reported (default 3)
#   BENCH_STARTUP_REPS  runs for the startup set (default 15)
#   BENCH_SETS          comma-separated subset of startup,parse,filter,output
#   BENCH_METRIC        auto (default), cycles, or wall
#
# The Markdown report goes to stdout; progress goes to stderr.

set -u

usage() {
    sed -n '5,/^# The Markdown/s/^# \{0,1\}//p' "$0" >&2
    exit 2
}

[ $# -gt 0 ] || usage
case $1 in -h|--help) usage ;; esac

here=$(cd "$(dirname "$0")" && pwd)
data=${BENCH_DATA:-${TMPDIR:-/tmp}/pathfinder-bench}
reps=${BENCH_REPS:-3}
sreps=${BENCH_STARTUP_REPS:-15}
sets=,${BENCH_SETS:-startup,parse,filter,output},
ref_jq=${BENCH_JQ:-jq}
ref_jaq=${BENCH_JAQ:-jaq}
metric=${BENCH_METRIC:-auto}
why=

tmp=$(mktemp -d "${TMPDIR:-/tmp}/pathfinder-bench-run.XXXXXX") || exit 1
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

set -f # engine specs are split on blanks; never glob them

# --- engines ---------------------------------------------------------------

n=0
for spec in "$@"; do
    name=${spec%%=*}
    rest=${spec#*=}
    case $name in
        ''|*[!A-Za-z0-9_.-]*) echo "bench/run: bad engine name in '$spec'" >&2; exit 2 ;;
    esac
    [ "$rest" != "$spec" ] && [ -n "$rest" ] || { echo "bench/run: '$spec' is not NAME=COMMAND" >&2; exit 2; }
    envp='' prog=''
    for w in $rest; do
        if [ -z "$prog" ]; then
            case $w in
                [A-Za-z_]*=*) envp="$envp $w"; continue ;;
            esac
        fi
        prog="$prog $w"
    done
    [ -n "$prog" ] || { echo "bench/run: '$spec' names no program" >&2; exit 2; }
    n=$((n + 1))
    eval "e_name_$n=\$name e_env_$n=\$envp e_prog_$n=\$prog"
    [ "$name" = "$ref_jq" ] && ijq=$n
    [ "$name" = "$ref_jaq" ] && ijaq=$n
done
ijq=${ijq:-0} ijaq=${ijaq:-0}

get() { eval "printf '%s' \"\${$1}\""; }

# --- metric ----------------------------------------------------------------

# In cycles mode one perf run counts cycles:u and instructions:u together.
# Cycles are R-011's measure; instructions are the stable cross-check
# (memory stalls cost more cycles at a higher clock, so cycle counts of
# memory-bound runs move with frequency scaling; instruction counts do not).
if [ "$metric" = auto ] || [ "$metric" = cycles ]; then
    probe=$(perf stat -x, -e cycles:u,instructions:u -o /dev/stdout -- true 2>/dev/null |
        awk -F, '$3 ~ /^cycles/ { print $1 }')
    case $probe in
        ''|*[!0-9]*)
            [ "$metric" = cycles ] && { echo "bench/run: perf cannot count cycles:u here" >&2; exit 1; }
            metric=wall why="perf could not count \`cycles:u\` on this host" ;;
        *) metric=cycles ;;
    esac
fi
if [ "$metric" = wall ]; then
    if command -v hyperfine >/dev/null 2>&1; then
        hyperfine=hyperfine
    else
        echo "bench/run: fetching hyperfine with nix" >&2
        hyperfine=$(nix build --no-link --print-out-paths nixpkgs#hyperfine | head -1)/bin/hyperfine ||
            { echo "bench/run: neither perf nor hyperfine is available" >&2; exit 1; }
    fi
    kinds=w
else
    kinds="c i"
fi

# --- inputs ----------------------------------------------------------------

for f in doc.json lines.jsonl small.json small.jsonl; do
    [ -s "$data/$f" ] || { echo "bench/run: generating inputs in $data" >&2; "$here/gen" "$data" >/dev/null || exit 1; break; }
done

# --- measuring -------------------------------------------------------------

# sq WORD: WORD single-quoted for a shell-words parser (hyperfine -N).
sq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# once I INPUT ARGS...: one run of engine I. Appends its figures (or "fail")
# to $tmp/c.I and $tmp/i.I (cycles mode) or $tmp/w.I (wall mode), and leaves
# its output's checksum in $tmp/sum.I.
once() {
    i=$1 in=$2
    shift 2
    envp=$(get "e_env_$i") prog=$(get "e_prog_$i")
    if [ "$metric" = cycles ]; then
        : >"$tmp/perf"
        { env $envp perf stat -x, -e cycles:u,instructions:u -o "$tmp/perf" -- $prog "$@" <"$in" 2>"$tmp/err"
          echo $? >"$tmp/rc"; } | cksum >"$tmp/sum.$i"
        c=$(awk -F, '$3 ~ /^cycles/ { print $1 }' "$tmp/perf")
        v=$(awk -F, '$3 ~ /^instructions/ { print $1 }' "$tmp/perf")
    else
        { env $envp $prog "$@" <"$in" 2>"$tmp/err"; echo $? >"$tmp/rc"; } | cksum >"$tmp/sum.$i"
        line=$(for w in $envp; do sq "$w"; printf ' '; done
               for w in $prog; do sq "$w"; printf ' '; done
               for a in "$@"; do sq "$a"; printf ' '; done)
        c=fail
        if [ "$(cat "$tmp/rc")" = 0 ] &&
            "$hyperfine" -N -w 1 -r "$runs" --input "$in" --export-json "$tmp/hf.json" \
                "env $line" >/dev/null 2>&1; then
            c=$(awk -F: '/"median"/ { gsub(/[ ,]/, "", $2); print $2; exit }' "$tmp/hf.json")
        fi
        v=
    fi
    rc=$(cat "$tmp/rc")
    if [ "$rc" != 0 ]; then
        c=fail v=fail
        printf 'exit %s: %s' "$rc" "$(head -c 120 "$tmp/err" | head -1)" >"$tmp/why.$i"
    fi
    case $c in ''|*[!0-9.]*) c=fail ;; esac
    case $v in ''|*[!0-9.]*) v=fail ;; esac
    if [ "$metric" = cycles ]; then
        echo "$c" >>"$tmp/c.$i"
        echo "$v" >>"$tmp/i.$i"
    else
        echo "$c" >>"$tmp/w.$i"
    fi
}

median() {
    grep -v fail "$1" | sort -n | awk '{ a[NR] = $1 }
        END { if (NR == 0) print "fail"
              else if (NR % 2) print a[(NR + 1) / 2]
              else printf "%.0f\n", (a[NR / 2] + a[NR / 2 + 1]) / 2 }'
}

# fmt KIND VALUE
fmt() {
    case $2 in fail|'') printf 'fail'; return ;; esac
    if [ "$1" = w ]; then
        awk -v v="$2" 'BEGIN { if (v >= 1) printf "%.3f s", v; else printf "%.2f ms", v * 1000 }'
    else
        awk -v v="$2" 'BEGIN {
            if (v >= 1e9) printf "%.2f G", v / 1e9
            else if (v >= 1e6) printf "%.2f M", v / 1e6
            else printf "%.0f k", v / 1e3 }'
    fi
}

ratio() {
    case $1$2 in *fail*) printf '—'; return ;; esac
    awk -v a="$1" -v b="$2" 'BEGIN { printf "%.2f", a / b }'
}

for k in $kinds; do for f in table over slower; do : >"$tmp/$f.$k"; done; done
: >"$tmp/fails"

# row KIND: the table row and the footer lines of one case for one metric.
row() {
    k=$1
    jqsum=; [ "$ijq" != 0 ] && jqsum=$(cat "$tmp/sum.$ijq")
    r="| $set_ | \`$(printf '%s' "$label" | sed 's/|/\\|/g')\` | $shown |"
    i=1
    while [ $i -le $n ]; do
        m=$(median "$tmp/$k.$i")
        eval "m_$i=\$m"
        cell=$(fmt "$k" "$m")
        if [ "$m" != fail ] && [ -n "$jqsum" ] && [ "$(cat "$tmp/sum.$i")" != "$jqsum" ]; then
            cell="$cell †"
        fi
        r="$r $cell |"
        i=$((i + 1))
    done
    i=1
    while [ $i -le $n ]; do
        if [ $i != "$ijq" ] && [ $i != "$ijaq" ]; then
            mi=$(get "m_$i") nm=$(get "e_name_$i")
            if [ "$ijq" != 0 ]; then
                x=$(ratio "$mi" "$(get "m_$ijq")"); r="$r $x |"
                case $x in —) ;; *) awk -v x="$x" 'BEGIN { exit !(x > 1.00) }' &&
                    echo "- \`$nm\` on \`$label\` ($shown): ${x}× jq" >>"$tmp/over.$k" ;; esac
            fi
            if [ "$ijaq" != 0 ]; then
                x=$(ratio "$mi" "$(get "m_$ijaq")"); r="$r $x |"
                case $x in —) ;; *) awk -v x="$x" 'BEGIN { exit !(x > 1.10) }' &&
                    echo "- \`$nm\` on \`$label\` ($shown): ${x}× jaq" >>"$tmp/over.$k" ;; esac
            fi
        fi
        i=$((i + 1))
    done
    if [ "$ijq" != 0 ] && [ "$ijaq" != 0 ]; then
        x=$(ratio "$(get "m_$ijaq")" "$(get "m_$ijq")")
        case $x in —) ;; *) awk -v x="$x" 'BEGIN { exit !(x > 1.00) }' &&
            echo "- \`$label\` ($shown): ${x}× jq" >>"$tmp/slower.$k" ;; esac
    fi
    echo "$r" >>"$tmp/table.$k"
    echo "$r" >&2
}

# bench SET INPUT ARGS...: one case, every engine.
bench() {
    set_=$1 input=$2
    shift 2
    case $sets in *",$set_,"*) ;; *) return ;; esac
    if [ "$input" = - ]; then in=/dev/null; shown=—; else in=$data/$input; shown=$input; fi
    label=$(printf '%s ' "$@" | sed 's/ $//')
    reps_=$reps; [ "$set_" = startup ] && reps_=$sreps
    echo "bench/run: $set_: $label ($shown)" >&2
    i=1
    while [ $i -le $n ]; do rm -f "$tmp/c.$i" "$tmp/i.$i" "$tmp/w.$i" "$tmp/why.$i"; i=$((i + 1)); done
    if [ "$metric" = cycles ]; then
        rep=0
        while [ $rep -lt "$reps_" ]; do # interleave engines, so drift hits all alike
            j=1
            while [ $j -le $n ]; do once $j "$in" "$@"; j=$((j + 1)); done
            rep=$((rep + 1))
        done
    else
        runs=$reps_ # hyperfine does the repetitions
        j=1
        while [ $j -le $n ]; do once $j "$in" "$@"; j=$((j + 1)); done
    fi
    j=1
    while [ $j -le $n ]; do
        [ -s "$tmp/why.$j" ] && echo "- \`$(get "e_name_$j")\` on \`$label\` ($shown): $(cat "$tmp/why.$j")" >>"$tmp/fails"
        j=$((j + 1))
    done
    for k in $kinds; do row "$k"; done
}

# --- the sets --------------------------------------------------------------

# Startup: the fixed cost of every invocation.
bench startup - -n .

# Parse: reading 30 MB, as one document and as ~210k small ones. `length`
# keeps output out of it; `-c .` and `.` add compact and pretty printing.
bench parse doc.json length
bench parse doc.json -c .
bench parse doc.json .
bench parse lines.jsonl length
bench parse lines.jsonl -c .
bench parse lines.jsonl .

# Filter: evaluation, with little input or output.
bench filter - -n '[range(1e6)] | map(. * 2) | add'
bench filter - -n 'reduce range(1e6) as $i (0; . + $i)'
bench filter small.jsonl -s 'group_by(.user) | map(length) | add'
bench filter small.jsonl -s 'sort_by(.score) | .[0].id'
bench filter small.jsonl -s 'map(.user) | unique | length'
bench filter small.json '[paths] | length'
bench filter small.jsonl '.text | ascii_downcase | length'
bench filter small.jsonl '.text | test("a[a-z]+o")'
bench filter small.jsonl 'tostring | length'
bench filter small.jsonl '.text | @base64 | length'

# Output: writing, with trivial filters.
bench output doc.json -S .
bench output doc.json --tab .
bench output doc.json -r '.items[].text'
bench output lines.jsonl -r .text
bench output lines.jsonl -a -c .

# --- the report ------------------------------------------------------------

cpu=$(awk -F': ' '/^model name/ { print $2; exit }' /proc/cpuinfo 2>/dev/null)
gov=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)
echo "# Pathfinder benchmark run"
echo
echo "- Date: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "- Host: ${cpu:-unknown CPU}, $(nproc 2>/dev/null || echo '?') threads, $(uname -sr)${gov:+, governor $gov}"
if [ "$metric" = cycles ]; then
    echo "- Metric: \`perf stat -e cycles:u,instructions:u\` (user space, children included), median of $reps runs ($sreps for startup)"
else
    echo "- Metric: **wall time** (\`hyperfine -N\`, median of $reps runs, $sreps for startup)${why:+ — $why}"
fi
echo "- Inputs (\`cksum\`):"
(cd "$data" && cksum doc.json lines.jsonl small.json small.jsonl) | sed 's/^/  - /'
echo "- Engines:"
i=1
while [ $i -le $n ]; do
    envp=$(get "e_env_$i") prog=$(get "e_prog_$i")
    ver=$(env $envp $prog --version 2>&1 </dev/null | head -1)
    echo "  - \`$(get "e_name_$i")\`: \`${envp# }${envp:+ }${prog# }\` — \`$ver\`"
    i=$((i + 1))
done
echo
echo "A † marks output that differs from \`$ref_jq\`'s (by \`cksum\`)."

head="| Set | Case | Input |"
rule="|---|---|---|"
i=1
while [ $i -le $n ]; do
    head="$head $(get "e_name_$i") |"; rule="$rule---:|"; i=$((i + 1))
done
i=1
while [ $i -le $n ]; do
    if [ $i != "$ijq" ] && [ $i != "$ijaq" ]; then
        nm=$(get "e_name_$i")
        [ "$ijq" != 0 ] && { head="$head $nm ×jq |"; rule="$rule---:|"; }
        [ "$ijaq" != 0 ] && { head="$head $nm ×jaq |"; rule="$rule---:|"; }
    fi
    i=$((i + 1))
done

for k in $kinds; do
    case $k in
        c) title="User-space cycles (R-011)" ;;
        i) title="User-space instructions (cross-check)" ;;
        w) title="Wall time" ;;
    esac
    echo
    echo "## $title"
    echo
    echo "$head"
    echo "$rule"
    cat "$tmp/table.$k"
    echo
    if [ "$ijq" != 0 ] || [ "$ijaq" != 0 ]; then
        echo "Over budget (×jq > 1.00 or ×jaq > 1.10):"
        echo
        if [ -s "$tmp/over.$k" ]; then cat "$tmp/over.$k"; else echo "- none"; fi
        echo
    fi
    if [ "$ijq" != 0 ] && [ "$ijaq" != 0 ]; then
        echo "Cases where \`$ref_jaq\` is slower than \`$ref_jq\`:"
        echo
        if [ -s "$tmp/slower.$k" ]; then cat "$tmp/slower.$k"; else echo "- none"; fi
    fi
done
if [ -s "$tmp/fails" ]; then
    echo
    echo "## Failed runs"
    echo
    echo "Counted as \`fail\`, no figure:"
    echo
    cat "$tmp/fails"
fi
